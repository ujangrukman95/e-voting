# ====================================================================
# KONFIGURASI ENVIRONMENT VARIABLE E-VOTING OSIS
# ====================================================================

# 1. Port & Runtime (Otomatis ditangani oleh platform / Docker / Node.js)
PORT=3000
NODE_ENV=production
AUTH_SECRET=your_custom_secure_jwt_secret_salt

# 2. Opsional: Custom Backend API URL (Jika frontend di-deploy terpisah di Vercel)
# Biarkan kosong jika backend dan frontend berada di server yang sama (/api)
VITE_API_URL=

# 3. Opsional: Supabase PostgreSQL (Jika ingin menggunakan database Supabase)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 4. Cloudinary Image Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=evoting

# 5. Gemini AI & System Keys
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
